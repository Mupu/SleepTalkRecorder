        <item quantity="one">%d recording</item>
        <item quantity="other">%d recordings</item>
    </plurals>
    <string name="library_empty">No sleeps yet. Start a recording on the home screen before you go to sleep.</string>

    <!-- Sleep screen -->
    <string name="play">Play</string>
    <string name="pause">Pause</string>
    <string name="timeline">Position in the sleep</string>
    <!-- Time into the sleep's audio, for example "Pos 6:10:00". -->
