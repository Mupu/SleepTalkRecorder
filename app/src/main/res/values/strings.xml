<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name" translatable="false">Sleep Talk Recorder</string>

    <!-- Sleep names. %1$s and %2$s are days formatted with the date patterns below. -->
    <string name="night_title">Night of %1$s to %2$s</string>
    <string name="nap_title">Nap on %1$s</string>
    <!-- java.time patterns: the first day of a night when both days are in the same month, a day
         with its month, and the date above a group of sleeps in the library. -->
    <string name="date_pattern_day">d</string>
    <string name="date_pattern_day_month">d MMMM</string>
    <string name="date_pattern_group">EEEE, d MMMM</string>

    <string name="duration_seconds">%1$d s</string>
    <string name="duration_minutes">%1$d min</string>
    <string name="duration_hours_minutes">%1$d h %2$02d min</string>
    <string name="time_range">%1$s–%2$s</string>

    <!-- Navigation -->
    <string name="library">Library</string>
    <string name="settings">Settings</string>
    <string name="back">Back</string>
    <string name="next">Next</string>

    <!-- Home -->
    <string name="ready">Ready for the night</string>
    <string name="record">Record</string>
    <string name="stop">Stop</string>
    <string name="starting">Starting…</string>
    <string name="live">REC</string>
    <string name="meter_idle">The level shows while recording</string>
    <string name="level_dbfs">%1$d dBFS</string>
    <string name="last_sleep">Last sleep</string>
    <string name="problem_not_allowed">Recording needs the microphone permission.</string>
    <string name="problem_microphone">The microphone is not available. The recording stopped.</string>
    <string name="problem_storage">The storage is full or not writable. The recording stopped.</string>

